<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Qwgram" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/qw_surface</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
    <style name="Theme.Qwgram.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/qw_surface</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_splash</item>
        <item name="windowSplashScreenIconBackgroundColor">@color/qw_brand</item>
        <item name="postSplashScreenTheme">@style/Theme.Qwgram</item>
    </style>
</resources>
